/// Tracks snapshot generation, validation, rollup, archive and rebuild jobs.
/// TODO(raw SQL migration): add CHECK constraints for priority, attempt, max_attempts and date ranges.
/// TODO(raw SQL migration): add partial indexes for RUNNING lease recovery and FAILED job diagnostics.
model SnapshotJob {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType              SnapshotJobType            @map("job_type")
  module               HistoricalDashboardModule?
  scopeKey             String                     @default("ALL") @map("scope_key")
  snapshotDate         DateTime?                  @map("snapshot_date") @db.Date
  fromDate             DateTime?                  @map("from_date") @db.Date
  toDate               DateTime?                  @map("to_date") @db.Date
  status               SnapshotJobStatus          @default(PENDING)
  priority             Int                        @default(50)
  attempt              Int                        @default(0)
  maxAttempts          Int                        @default(3) @map("max_attempts")
  requestedBy          String?                    @map("requested_by")
  rebuildRequestId     String?                    @map("rebuild_request_id") @db.Uuid
  leaseOwner           String?                    @map("lease_owner")
  leaseExpiresAt       DateTime?                  @map("lease_expires_at")
  startedAt            DateTime?                  @map("started_at")
  completedAt          DateTime?                  @map("completed_at")
  failedAt             DateTime?                  @map("failed_at")
  errorCode            String?                    @map("error_code")
  errorMessage         String?                    @map("error_message")
  rowsRead             BigInt                     @default(0) @map("rows_read")
  rowsWritten          BigInt                     @default(0) @map("rows_written")
  sourceWatermarkStart String?                    @map("source_watermark_start")
  sourceWatermarkEnd   String?                    @map("source_watermark_end")
  metadata             Json                       @default("{}") @db.JsonB
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  rebuildRequest            SnapshotRebuildRequest?    @relation(fields: [rebuildRequestId], references: [id], onDelete: SetNull)
  logs                      SnapshotJobLog[]
  dashboardSnapshots        DashboardSnapshot[]
  inventoryBalanceSnapshots InventoryBalanceSnapshot[]
  dashboardMonthlyRollups   DashboardMonthlyRollup[]
  inventoryMonthlyRollups   InventoryMonthlyRollup[]
  metadataRecords           SnapshotMetadata[]         @relation("SnapshotMetadataLastSuccessfulJob")

  @@index([status, priority(sort: Desc), createdAt], map: "snapshot_jobs_queue_idx")
  @@index([leaseExpiresAt], map: "snapshot_jobs_lease_expires_idx")
  @@index([jobType, module, snapshotDate], map: "snapshot_jobs_type_module_date_idx")
  @@index([rebuildRequestId], map: "snapshot_jobs_rebuild_request_idx")
  @@index([createdAt(sort: Desc)], map: "snapshot_jobs_created_at_idx")
  @@map("snapshot_jobs")
}

