// =========================================================
// WORK ORDER
// =========================================================

model WorkOrder {
  id String @id @default(uuid())

  workOrderNo String @unique

  productCode String

  quantity Float

  plannedStart DateTime?

  plannedEnd DateTime?

  status String @default("PLANNED")

  productionOrderId  String?
  routingOperationId String?
  sequence           Int?
  lifecycleState     ProductionWorkOrderState?
  aggregateVersion   Int                       @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  pausedAt           DateTime?
  blockedReason      String?
  metadata           Json?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  productionOrder    ProductionOrder?             @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  executions         ProductionExecution[]
  instanceExecutions ComponentInstanceExecution[]
  completions        ProductionCompletion[]
  scraps             ProductionScrap[]

  @@unique([productionOrderId, sequence])
  @@index([productionOrderId, lifecycleState])
  @@index([routingOperationId])
}

model ProductionExecution {
  id                String                   @id @default(uuid())
  productionOrderId String
  workOrderId       String
  state             ProductionExecutionState @default(CREATED)
  aggregateVersion  Int                      @default(1)
  workCenterId      String?
  machineId         String?
  startedAt         DateTime?
  pausedAt          DateTime?
  resumedAt         DateTime?
  completedAt       DateTime?
  abortedAt         DateTime?
  pauseReason       String?
  abortReason       String?
  createdBy         String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  productionOrder    ProductionOrder              @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workOrder          WorkOrder                    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  instanceExecutions ComponentInstanceExecution[]

  @@index([productionOrderId, state])
  @@index([workOrderId, state])
  @@index([workCenterId])
  @@index([machineId])
  @@map("production_executions")
}

model ProductionCompletion {
  id                     String                    @id @default(uuid())
  productionOrderId      String
  workOrderId            String?
  executionRunId         String?
  state                  ProductionCompletionState @default(RECORDED)
  quantity               Float
  unit                   String
  completedQty           Float
  rejectedQty            Float                     @default(0)
  scrapQty               Float                     @default(0)
  remainingQty           Float
  reversalOfCompletionId String?
  evidence               Json?
  aggregateVersion       Int                       @default(1)
  recordedBy             String?
  recordedAt             DateTime                  @default(now())

  productionOrder ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workOrder       WorkOrder?             @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  reversalOf      ProductionCompletion?  @relation("ProductionCompletionReversal", fields: [reversalOfCompletionId], references: [id], onDelete: SetNull)
  reversals       ProductionCompletion[] @relation("ProductionCompletionReversal")

  @@index([productionOrderId, recordedAt])
  @@index([workOrderId])
  @@index([reversalOfCompletionId])
}

model ProductionScrap {
  id                     String               @id @default(uuid())
  productionOrderId      String
  workOrderId            String?
  executionRunId         String?
  inventoryItemId        String?
  state                  ProductionScrapState @default(DRAFT)
  quantity               Float
  unit                   String
  reasonCode             String
  disposition            String
  recoverable            Boolean              @default(false)
  inventoryTransactionId String?
  reversalOfScrapId      String?
  commandIdempotencyKey  String?              @unique
  commandHash            String?
  aggregateVersion       Int                  @default(1)
  createdBy              String?
  postedBy               String?
  postedAt               DateTime?
  reversedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  productionOrder ProductionOrder   @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workOrder       WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  reversalOf      ProductionScrap?  @relation("ProductionScrapReversal", fields: [reversalOfScrapId], references: [id], onDelete: SetNull)
  reversals       ProductionScrap[] @relation("ProductionScrapReversal")

  @@index([productionOrderId, state])
  @@index([workOrderId])
  @@index([inventoryItemId])
  @@index([reversalOfScrapId])
}

model ProductionRework {
  id                        String                @id @default(uuid())
  reworkRequestId           String                @unique
  qcNcrId                   String
  originalProductionOrderId String
  reworkProductionOrderId   String?               @unique
  componentInstanceId       String?
  state                     ProductionReworkState
  routingScope              Json?
  reason                    String?
  aggregateVersion          Int                   @default(1)
  decidedBy                 String?
  decidedAt                 DateTime              @default(now())
  completedAt               DateTime?

  originalProductionOrder ProductionOrder    @relation("OriginalProductionRework", fields: [originalProductionOrderId], references: [id], onDelete: Restrict)
  reworkProductionOrder   ProductionOrder?   @relation("AcceptedProductionRework", fields: [reworkProductionOrderId], references: [id], onDelete: SetNull)
  componentInstance       ComponentInstance? @relation("ComponentInstanceProductionReworks", fields: [componentInstanceId], references: [id], onDelete: SetNull)

  @@index([qcNcrId])
  @@index([originalProductionOrderId, state])
  @@index([componentInstanceId])
}

