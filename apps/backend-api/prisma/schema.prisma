//
// OUTBOX + BACKGROUND JOBS
//

model OutboxEvent {
  id             String            @id @default(cuid())
  eventName      String
  payload        Json
  metadata       Json?
  status         OutboxEventStatus @default(PENDING)
  idempotencyKey String?
  retryCount     Int               @default(0)
  maxRetries     Int               @default(5)
  nextAttemptAt  DateTime          @default(now())
  dispatchedAt   DateTime?
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  deadLetteredAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([status, nextAttemptAt, createdAt, id], map: "outbox_events_claim_idx")
  @@index([eventName])
  @@index([createdAt])
  @@index([createdAt, id], map: "outbox_events_createdAt_id_idx")
  @@index([updatedAt(sort: Desc), id], map: "outbox_events_updatedAt_id_idx")
  @@map("outbox_events")
}

model EnterpriseProjectionDocument {
  id                     String   @id @default(cuid())
  projectionName         String
  entityKey              String
  scopeKey               String?
  schemaVersion          Int      @default(1)
  data                   Json
  sourceEventId          String
  sourceEventName        String
  sourceAggregateVersion BigInt?
  sourceOccurredAt       DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([projectionName, entityKey])
  @@index([projectionName, scopeKey])
  @@index([projectionName, updatedAt])
  @@index([projectionName, sourceOccurredAt(sort: Desc), id], map: "projection_documents_name_occurredAt_id_idx")
  @@index([projectionName, scopeKey, sourceOccurredAt(sort: Desc), id], map: "projection_documents_scope_occurredAt_id_idx")
  @@index([sourceEventId])
  @@map("enterprise_projection_documents")
}

model EnterpriseProjectionCheckpoint {
  projectionName    String    @id
  schemaVersion     Int       @default(1)
  lastOutboxEventId String?
  lastOccurredAt    DateTime?
  lastProcessedAt   DateTime?
  processedCount    Int       @default(0)
  failedCount       Int       @default(0)
  lagMs             Int       @default(0)
  status            String    @default("HEALTHY")
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([updatedAt])
  @@map("enterprise_projection_checkpoints")
}

model EnterpriseProjectionReceipt {
  id               String   @id @default(cuid())
  projectionName   String
  outboxEventId    String
  eventName        String
  aggregateId      String?
  aggregateVersion BigInt?
  processedAt      DateTime @default(now())

  @@unique([projectionName, outboxEventId])
  @@index([projectionName, processedAt])
  @@index([eventName])
  @@map("enterprise_projection_receipts")
}

model EnterpriseProjectionFailure {
  id             String    @id @default(cuid())
  projectionName String
  outboxEventId  String
  eventName      String
  payload        Json
  metadata       Json?
  error          String
  retryCount     Int       @default(1)
  status         String    @default("RETRYING")
  lastAttemptAt  DateTime  @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([projectionName, outboxEventId])
  @@index([status, lastAttemptAt])
  @@index([projectionName, status])
  @@map("enterprise_projection_failures")
}

model BackgroundJob {
  id             String              @id @default(cuid())
  name           String
  queue          String              @default("default")
  payload        Json
  status         BackgroundJobStatus @default(QUEUED)
  idempotencyKey String?
  priority       Int                 @default(0)
  runAt          DateTime            @default(now())
  retryCount     Int                 @default(0)
  maxRetries     Int                 @default(5)
  lockedAt       DateTime?
  lockedBy       String?
  heartbeatAt    DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  deadLetteredAt DateTime?
  lastError      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  executions JobExecution[]

  @@unique([idempotencyKey])
  @@index([queue, status, runAt])
  @@index([status, priority(sort: Desc), runAt, id], map: "background_jobs_claim_idx")
  @@index([updatedAt(sort: Desc), id], map: "background_jobs_updatedAt_id_idx")
  @@index([name])
  @@index([heartbeatAt])
  @@map("background_jobs")
}

model JobExecution {
  id          String             @id @default(cuid())
  jobId       String
  status      JobExecutionStatus @default(STARTED)
  workerId    String?
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  durationMs  Int?
  error       String?
  metadata    Json?

  job BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([jobId, startedAt(sort: Desc), id], map: "job_executions_jobId_startedAt_id_idx")
  @@index([status])
  @@index([startedAt])
  @@map("job_executions")
}

