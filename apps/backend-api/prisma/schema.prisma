model MasterWorkflowStatus {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  color       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  @@index([active])
  @@map("master_workflow_statuses")
}

model MasterUnit {
  id String @id @default(cuid())

  code String @unique

  name String

  symbol String

  category String

  precision Int @default(0)

  active Boolean @default(true)

  baseUnitId String?

  conversionFactor Float?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  createdBy String?

  updatedBy String?

  baseUnit MasterUnit? @relation("UnitConversionBase", fields: [baseUnitId], references: [id])

  derivedUnits MasterUnit[] @relation("UnitConversionBase")

  inventoryItems   InventoryItem[]
  transactionItems InventoryTransactionItem[]
  returnItems      ReturnRequestItem[]

  @@index([category])
  @@index([active])
  @@index([baseUnitId])
  @@map("master_units")
}

model InventoryItem {
  id String @id @default(cuid())

  code String @unique

  name String

  description String?

  quantity Float @default(0)

  minimumStock Float @default(0)

  unit String?

  unitId String?

  categoryId String

  materialTypeId String?

  materialUsageType MaterialUsageType @default(PRIMARY)

  materialUsageTypeId String?

  zoneId String?

  slotId String?

  level String?

  locationStocks InventoryLocationStock[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  category InventoryCategory @relation(fields: [categoryId], references: [id])

  materialType MaterialType? @relation(fields: [materialTypeId], references: [id])

  materialUsageTypeMaster MasterMaterialUsageType? @relation(fields: [materialUsageTypeId], references: [id], onDelete: SetNull)

  unitMaster MasterUnit? @relation(fields: [unitId], references: [id])

  zone WarehouseZone? @relation(fields: [zoneId], references: [id])

  transactionItems                   InventoryTransactionItem[]
  returnItems                        ReturnRequestItem[]
  bomItems                           BOMItem[]
  productionMaterialIssues           ProductionMaterialIssue[]
  productionMaterialReservationLines ProductionMaterialReservationLine[]
  productionMaterialLedgers          ProductionMaterialLedger[]
  productionMaterialConsumptions     ProductionMaterialConsumption[]
  projectTaskMaterialAllocations     ProjectTaskMaterialAllocation[]
  dispatchItems                      DispatchItem[]
  materialSnapshots                  InventoryMaterialSnapshot[]

  @@index([code])
  @@index([name])
  @@index([unitId])
  @@index([materialTypeId])
  @@index([materialUsageType])
  @@index([materialUsageTypeId])
  @@index([slotId])
  @@index([level])
  @@index([deletedAt])
  @@map("inventory_items")
}

enum MaterialUsageType {
  PRIMARY
  SECONDARY
  CONSUMABLE
}

model InventoryTransaction {
  id String @id @default(cuid())

  code String @unique

  transactionNo String? @unique

  type TransactionType

  transactionTypeId String?

  direction String?

  note String?

  performedBy String?

  approvedBy String?

  referenceModule String?

  referenceId String?

  projectId String?

  supplierId String?

  warehouseId String?

  zoneId String?

  remarks String?

  transactionDate DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  transactionType MasterTransactionType? @relation(fields: [transactionTypeId], references: [id])

  project Project? @relation(fields: [projectId], references: [id])

  warehouse MasterWarehouse? @relation(fields: [warehouseId], references: [id])

  zone WarehouseZone? @relation(fields: [zoneId], references: [id])

  items InventoryTransactionItem[]

  @@index([type])
  @@index([transactionTypeId])
  @@index([direction])
  @@index([warehouseId])
  @@index([zoneId])
  @@index([projectId])
  @@index([transactionDate])
  @@index([transactionDate(sort: Desc), id], map: "inventory_transactions_transactionDate_id_idx")
  @@index([type, transactionDate(sort: Desc)], map: "inventory_transactions_type_transactionDate_idx")
  @@index([projectId, transactionDate(sort: Desc)], map: "inventory_transactions_projectId_transactionDate_idx")
  @@index([type, referenceModule, referenceId], map: "inventory_transactions_reference_idx")
  @@map("inventory_transactions")
}

model InventoryTransactionItem {
  id String @id @default(cuid())

  transactionId String

  inventoryItemId String

  quantity Float

  unitPrice Float?

  totalAmount Float?

  unitId String?

  warehouseId String?

  zoneId String?

  slotId String?

  level String?

  createdAt DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  transaction InventoryTransaction @relation(fields: [transactionId], references: [id])

  unit MasterUnit? @relation(fields: [unitId], references: [id])

  warehouse MasterWarehouse? @relation(fields: [warehouseId], references: [id])

  zone WarehouseZone? @relation(fields: [zoneId], references: [id])

  @@index([inventoryItemId, createdAt(sort: Desc)], map: "inventory_transaction_items_inventoryItemId_createdAt_idx")
  @@index([transactionId, inventoryItemId], map: "inventory_transaction_items_transactionId_inventoryItemId_idx")
  @@map("inventory_transaction_items")
}

model InventoryLocationStock {
  id              String         @id @default(cuid())
  inventoryItemId String
  warehouseId     String?
  zoneId          String?
  slotId          String?
  level           String?
  quantity        Float          @default(0)
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  zone            WarehouseZone? @relation(fields: [zoneId], references: [id])

  @@index([inventoryItemId])
  @@index([zoneId, slotId, level])
  @@index([inventoryItemId, warehouseId, zoneId, slotId, level], map: "inventory_location_stocks_item_bucket_idx")
  @@map("inventory_location_stocks")
}

model ReturnRequest {
  id          String              @id @default(cuid())
  returnNo    String              @unique
  flowType    ReturnFlowType
  status      ReturnRequestStatus @default(REQUESTED)
  projectId   String?
  supplierId  String?
  warehouseId String?
  requestedBy String?
  approvedBy  String?
  receivedBy  String?
  inspectedBy String?
  remarks     String?
  requestedAt DateTime            @default(now())
  approvedAt  DateTime?
  receivedAt  DateTime?
  inspectedAt DateTime?
  disposedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project   Project?            @relation(fields: [projectId], references: [id])
  warehouse MasterWarehouse?    @relation(fields: [warehouseId], references: [id])
  items     ReturnRequestItem[]

  @@index([flowType])
  @@index([status])
  @@index([projectId])
  @@index([warehouseId])
  @@index([projectId, status, createdAt(sort: Desc)], map: "return_requests_projectId_status_createdAt_idx")
  @@index([flowType, status, createdAt(sort: Desc)], map: "return_requests_flowType_status_createdAt_idx")
  @@map("return_requests")
}

model ReturnRequestItem {
  id                String             @id @default(cuid())
  returnRequestId   String
  inventoryItemId   String
  requestedQuantity Float
  receivedQuantity  Float?
  inspectedQuantity Float?
  disposition       ReturnDisposition?
  unitId            String?
  zoneId            String?
  remarks           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  returnRequest ReturnRequest  @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
