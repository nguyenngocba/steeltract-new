}

model Machine {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  description  String?
  status       MachineStatus @default(AVAILABLE)
  workCenterId String?
  utilization  Float         @default(0)
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workCenter WorkCenter?          @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  stages     ProductionStage[]
  tasks      ProductionTask[]
  schedules  ProductionSchedule[]

  @@index([status])
  @@index([workCenterId])
  @@map("machines")
}

model ProductionOrder {
  id                        String                @id @default(cuid())
  orderNo                   String                @unique
  title                     String
  description               String?
  projectId                 String?
  componentId               String?
  componentRequirementId    String?
  bomId                     String?
  quantity                  Float                 @default(1)
  priority                  TaskPriority          @default(MEDIUM)
  status                    ProductionOrderStatus @default(DRAFT)
  orderKind                 ProductionOrderKind   @default(STANDARD)
  aggregateVersion          Int                   @default(0)
  componentRevisionId       String?
  bomDefinitionId           String?
  reworkOfProductionOrderId String?
  currentStageCode          ProductionStageCode?
  plannedStartAt            DateTime?
  plannedEndAt              DateTime?
  startedAt                 DateTime?
  releasedAt                DateTime?
  readyAt                   DateTime?
  pausedAt                  DateTime?
  completedAt               DateTime?
  closedAt                  DateTime?
  cancelledAt               DateTime?
  delayedAt                 DateTime?
  delayReason               String?
  workflowInstanceId        String?
  metadata                  Json?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  stages               ProductionStage[]
  tasks                ProductionTask[]
  schedules            ProductionSchedule[]
  logs                 ProductionLog[]
  bom                  BOM?                            @relation(fields: [bomId], references: [id], onDelete: SetNull)
  component            Component?                      @relation(fields: [componentId], references: [id], onDelete: SetNull)
  componentRequirement ProjectComponentRequirement?    @relation(fields: [componentRequirementId], references: [id], onDelete: SetNull)
  materialIssues       ProductionMaterialIssue[]
  materialReservations ProductionMaterialReservation[]
  materialLedgers      ProductionMaterialLedger[]
  materialConsumptions ProductionMaterialConsumption[]
  componentCostings    ComponentCosting[]
  snapshot             ProductionOrderSnapshot?
  workOrders           WorkOrder[]
  executions           ProductionExecution[]
  completions          ProductionCompletion[]
  scraps               ProductionScrap[]
  reworkOf             ProductionOrder?                @relation("ProductionOrderRework", fields: [reworkOfProductionOrderId], references: [id], onDelete: SetNull)
  reworkOrders         ProductionOrder[]               @relation("ProductionOrderRework")
  reworkRequests       ProductionRework[]              @relation("OriginalProductionRework")
  acceptedRework       ProductionRework?               @relation("AcceptedProductionRework")
  componentInstances   ComponentInstance[]

  @@index([status])
  @@index([projectId])
  @@index([componentId])
  @@index([componentRequirementId])
  @@index([bomId])
  @@index([orderKind])
  @@index([componentRevisionId])
  @@index([bomDefinitionId])
  @@index([reworkOfProductionOrderId])
  @@index([currentStageCode])
  @@map("production_orders")
}

model ProductionStage {
  id                String                @id @default(cuid())
  productionOrderId String
  code              ProductionStageCode
  name              String
  sequence          Int
  status            ProductionStageStatus @default(PENDING)
  workCenterId      String?
  machineId         String?
  assignedWorkerId  String?
  plannedStartAt    DateTime?
  plannedEndAt      DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  qualityStatus     String?
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  productionOrder ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workCenter      WorkCenter?      @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  machine         Machine?         @relation(fields: [machineId], references: [id], onDelete: SetNull)
  tasks           ProductionTask[]
  logs            ProductionLog[]

  @@unique([productionOrderId, code])
  @@unique([productionOrderId, sequence])
  @@index([status])
  @@index([workCenterId])
  @@index([machineId])
  @@map("production_stages")
}

model ProductionTask {
  id                String               @id @default(cuid())
  productionOrderId String
  stageId           String?
  title             String
  description       String?
  status            ProductionTaskStatus @default(TODO)
  priority          TaskPriority         @default(MEDIUM)
  workCenterId      String?
  machineId         String?
  assignedWorkerId  String?
  plannedStartAt    DateTime?
  plannedEndAt      DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  productionOrder ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stage           ProductionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  workCenter      WorkCenter?      @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  machine         Machine?         @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([productionOrderId])
  @@index([stageId])
  @@index([assignedWorkerId])
  @@map("production_tasks")
}

model ProductionSchedule {
  id                String   @id @default(cuid())
  productionOrderId String
  workCenterId      String?
  machineId         String?
  startAt           DateTime
  endAt             DateTime
  capacityPlanned   Float?
  capacityUsed      Float?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workCenter      WorkCenter?     @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  machine         Machine?        @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@index([startAt, endAt])
  @@index([workCenterId])
  @@index([machineId])
  @@map("production_schedules")
}

model ProductionLog {
  id                String            @id @default(cuid())
  productionOrderId String
  stageId           String?
  type              ProductionLogType @default(NOTE)
  message           String
  quantity          Float?
  workerId          String?
  machineId         String?
  attachmentIds     String[]          @default([])
  metadata          Json?
  createdAt         DateTime          @default(now())

  productionOrder ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stage           ProductionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([productionOrderId])
  @@index([stageId])
  @@index([type])
  @@index([createdAt])
  @@map("production_logs")
}

//
// QUALITY CONTROL
//

model QcChecklist {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  type        QcChecklistType @default(FINAL)
  revision    String          @default("A")
  description String?
  isActive    Boolean         @default(true)
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items       QcChecklistItem[]
  inspections QcInspection[]

  @@index([type])
  @@index([isActive])
  @@map("qc_checklists")
}

model QcChecklistItem {
  id            String   @id @default(cuid())
  checklistId   String
  sequence      Int
  title         String
  description   String?
  required      Boolean  @default(true)
  expectedValue String?
  tolerance     String?
  unit          String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  checklist QcChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  results   QcResult[]

  @@unique([checklistId, sequence])
  @@index([checklistId])
  @@map("qc_checklist_items")
}

model QcInspection {
  id                  String             @id @default(cuid())
  inspectionNo        String             @unique
  checklistId         String?
  productionOrderId   String?
  productionStageId   String?
  componentInstanceId String?
  componentId         String?
  projectId           String?
  status              QcInspectionStatus @default(DRAFT)
  inspectorId         String?
  startedAt           DateTime?
  completedAt         DateTime?
  approvedById        String?
  approvedAt          DateTime?
  rejectedById        String?
  rejectedAt          DateTime?
  rejectionReason     String?
  workflowInstanceId  String?
  metadata            Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  checklist         QcChecklist?           @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  componentInstance ComponentInstance?     @relation(fields: [componentInstanceId], references: [id], onDelete: SetNull)
  results           QcResult[]
  issues            QcIssue[]
  attachments       QcAttachment[]
  ncrs              NonConformanceReport[]
  snapshot          QcInspectionSnapshot?

  @@index([status])
  @@index([productionOrderId])
  @@index([productionStageId])
  @@index([componentInstanceId])
  @@index([componentId])
  @@index([projectId])
  @@index([checklistId])
  @@map("qc_inspections")
}

model QcResult {
  id              String          @id @default(cuid())
  inspectionId    String
  checklistItemId String?
  category        QcChecklistType @default(FINAL)
  status          QcResultStatus  @default(PENDING)
  measuredValue   String?
  expectedValue   String?
  tolerance       String?
  unit            String?
  notes           String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  inspection    QcInspection     @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItem QcChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  issues        QcIssue[]

  @@index([inspectionId])
  @@index([checklistItemId])
  @@index([category])
  @@index([status])
  @@map("qc_results")
}

model QcIssue {
  id               String          @id @default(cuid())
  inspectionId     String
  resultId         String?
  code             String?
  title            String
  description      String?
  severity         QcIssueSeverity @default(MEDIUM)
  status           QcIssueStatus   @default(OPEN)
  correctiveAction String?
  assignedToId     String?
  createdById      String?
  dueAt            DateTime?
  resolvedAt       DateTime?
  verifiedAt       DateTime?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  inspection  QcInspection           @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  result      QcResult?              @relation(fields: [resultId], references: [id], onDelete: SetNull)
  attachments QcAttachment[]
  ncrs        NonConformanceReport[]

  @@index([inspectionId])
  @@index([resultId])
  @@index([severity])
  @@index([status])
  @@map("qc_issues")
}

model QcAttachment {
  id           String   @id @default(cuid())
  inspectionId String?
  issueId      String?
  ncrId        String?
  attachmentId String
  purpose      String   @default("")
  metadata     Json?
  createdAt    DateTime @default(now())

  inspection QcInspection?         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  issue      QcIssue?              @relation(fields: [issueId], references: [id], onDelete: Cascade)
  ncr        NonConformanceReport? @relation(fields: [ncrId], references: [id], onDelete: Cascade)
  attachment Attachment            @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@index([inspectionId])
  @@index([issueId])
  @@index([ncrId])
  @@index([attachmentId])
  @@map("qc_attachments")
}

model NonConformanceReport {
  id                  String          @id @default(cuid())
  ncrNo               String          @unique
  inspectionId        String
  issueId             String?
  productionOrderId   String?
  componentInstanceId String?
  componentId         String?
  status              NcrStatus       @default(OPEN)
  severity            QcIssueSeverity @default(HIGH)
  title               String
  description         String?
  rootCause           String?
  correctiveAction    String?
  disposition         String?
  raisedById          String?
  approvedById        String?
  closedAt            DateTime?
  metadata            Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  inspection        QcInspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  issue             QcIssue?           @relation(fields: [issueId], references: [id], onDelete: SetNull)
  componentInstance ComponentInstance? @relation(fields: [componentInstanceId], references: [id], onDelete: SetNull)
  attachments       QcAttachment[]

  @@index([inspectionId])
  @@index([issueId])
  @@index([productionOrderId])
  @@index([componentInstanceId])
  @@index([componentId])
  @@index([status])
  @@index([severity])
  @@map("non_conformance_reports")
}

//
// YARD
//

model YardZone {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  status      YardZoneStatus @default(ACTIVE)
  originX     Float          @default(0)
  originY     Float          @default(0)
  width       Float          @default(0)
  height      Float          @default(0)
  color       String         @default("#06b6d4")
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  rows      YardRow[]
  slots     YardSlot[]
  snapshots YardSnapshot[]

  @@index([status])
  @@map("yard_zones")
}

model YardRow {
  id        String   @id @default(cuid())
  zoneId    String
  code      String
  name      String?
  index     Int
  originX   Float    @default(0)
  originY   Float    @default(0)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone  YardZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  slots YardSlot[]

  @@unique([zoneId, code])
  @@unique([zoneId, index])
  @@index([zoneId])
  @@map("yard_rows")
}

model YardSlot {
  id                String         @id @default(cuid())
  zoneId            String
  rowId             String?
  code              String
  status            YardSlotStatus @default(AVAILABLE)
  x                 Float
  y                 Float
  width             Float          @default(1)
  height            Float          @default(1)
  maxStackLevel     Int            @default(1)
  currentStackLevel Int            @default(0)
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  zone       YardZone            @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  row        YardRow?            @relation(fields: [rowId], references: [id], onDelete: SetNull)
  placements YardItemPlacement[]
  fromMoves  YardMovement[]      @relation("YardMovementFromSlot")
  toMoves    YardMovement[]      @relation("YardMovementToSlot")

  @@unique([zoneId, code])
  @@index([zoneId])
  @@index([rowId])
  @@index([status])
  @@map("yard_slots")
}

model YardItemPlacement {
  id                  String       @id @default(cuid())
  slotId              String
  componentInstanceId String?
  itemType            YardItemType
  itemId              String
  itemCode            String
  itemName            String?
  quantity            Float        @default(1)
  stackLevel          Int          @default(1)
  weight              Float?
  length              Float?
  width               Float?
  height              Float?
  placedById          String?
  placedAt            DateTime     @default(now())
  removedAt           DateTime?
  metadata            Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  stagedQuantity      Float        @default(0)

  remainingQuantity Float              @default(0)
  slot              YardSlot           @relation(fields: [slotId], references: [id], onDelete: Restrict)
  componentInstance ComponentInstance? @relation("ComponentInstanceYardPlacements", fields: [componentInstanceId], references: [id], onDelete: SetNull)
  movements         YardMovement[]

  @@index([slotId])
  @@index([componentInstanceId])
  @@index([itemType, itemId])
  @@index([itemCode])
  @@index([removedAt])
  @@map("yard_item_placements")
}

model YardMovement {
  id                  String           @id @default(cuid())
  placementId         String?
  componentInstanceId String?
  type                YardMovementType
  itemType            YardItemType
  itemId              String
  itemCode            String
  fromSlotId          String?
  toSlotId            String?
  craneId             String?
  movedById           String?
  reason              String?
  metadata            Json?
  createdAt           DateTime         @default(now())

  placement         YardItemPlacement? @relation(fields: [placementId], references: [id], onDelete: SetNull)
  componentInstance ComponentInstance? @relation("ComponentInstanceYardMovements", fields: [componentInstanceId], references: [id], onDelete: SetNull)
  fromSlot          YardSlot?          @relation("YardMovementFromSlot", fields: [fromSlotId], references: [id], onDelete: SetNull)
  toSlot            YardSlot?          @relation("YardMovementToSlot", fields: [toSlotId], references: [id], onDelete: SetNull)
  crane             Crane?             @relation(fields: [craneId], references: [id], onDelete: SetNull)

  @@index([itemType, itemId])
  @@index([componentInstanceId])
  @@index([fromSlotId])
  @@index([toSlotId])
  @@index([craneId])
  @@index([createdAt])
  @@map("yard_movements")
}

model Crane {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  status      CraneStatus @default(AVAILABLE)
  currentX    Float       @default(0)
  currentY    Float       @default(0)
  utilization Float       @default(0)
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  movements YardMovement[]

  @@index([status])
  @@map("cranes")
}

model YardSnapshot {
  id            String   @id @default(cuid())
  zoneId        String?
  name          String
  occupancyRate Float    @default(0)
  totalSlots    Int      @default(0)
  occupiedSlots Int      @default(0)
  heatmap       Json?
  congestion    Json?
  payload       Json
  generatedById String?
  createdAt     DateTime @default(now())

  zone YardZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([zoneId])
  @@index([createdAt])
  @@map("yard_snapshots")
}

//
// ACTIVITY LOGS
//

model ActivityLog {
  id String @id @default(cuid())

  action String

  entity String

  entityId String?

  module String?

  userId String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([module, createdAt(sort: Desc)], map: "activity_logs_module_createdAt_idx")
  @@index([entity, entityId, createdAt(sort: Desc)], map: "activity_logs_entity_entityId_createdAt_idx")
  @@map("activity_logs")
}

// =========================================================
// SUPPLIER
// =========================================================

model Supplier {
  id String @id @default(uuid())

  code String @unique

  name String

  contact String?

  phone String?

  email String?

  address String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// =========================================================
// PURCHASE RECEIVING
// =========================================================

model PurchaseReceiving {
  id String @id @default(uuid())

  receivingNo String @unique

  supplierId String

  materialId String

  quantity Float

  status String @default("RECEIVED")

  createdAt DateTime @default(now())
}

// =========================================================
// BOM
// =========================================================

model BOM {
  id String @id @default(uuid())

  bomNo String @unique

  productCode String

  productName String

  structureType String?

  projectId String?

  unit String?

  estimatedWeight Float @default(0)

  version String

  status String @default("ACTIVE")

  componentId String?

  componentRevisionId String?

  bomDefinitionId String? @unique

  engineeringContentHash String?

  source String @default("MANUAL")

  materializedAt DateTime?

  materializedBy String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  items BOMItem[]

  routingSteps BOMRoutingStep[]

  productionOrders ProductionOrder[]

  materialReservations ProductionMaterialReservation[]

  component Component? @relation("ComponentProductionBoms", fields: [componentId], references: [id], onDelete: SetNull)

  componentRevision ComponentRevision? @relation("ComponentRevisionProductionBoms", fields: [componentRevisionId], references: [id], onDelete: SetNull)

  bomDefinition ComponentBomDefinition? @relation("ComponentBomDefinitionProductionBom", fields: [bomDefinitionId], references: [id], onDelete: SetNull)

  @@index([componentId])
  @@index([componentRevisionId])
  @@index([engineeringContentHash])
  @@index([componentId, status])
}

model BOMItem {
  id String @id @default(uuid())

  bomId String

  materialId String

  quantity Float

  wastePercent Float @default(0)

  category String @default("MAIN_MATERIAL")

  bom BOM @relation(fields: [bomId], references: [id])

  material InventoryItem @relation(fields: [materialId], references: [id])

  reservationLines ProductionMaterialReservationLine[]

  @@index([bomId])
  @@index([materialId])
}

model BOMRoutingStep {
  id String @id @default(uuid())

  bomId String

  stepNo Int

  stepName String

  workshop String?

  expectedHours Float @default(0)

  qcRequired Boolean @default(false)

  bom BOM @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@unique([bomId, stepNo])
  @@index([bomId])
}

model ProductionMaterialReservation {
  id                String                              @id @default(uuid())
  reservationNo     String                              @unique
  productionOrderId String
  bomId             String?
  status            ProductionMaterialReservationStatus @default(DRAFT)
  reservedBy        String?
  reservedAt        DateTime?
  expiresAt         DateTime?
  releasedAt        DateTime?
  note              String?
  createdAt         DateTime                            @default(now())
  updatedAt         DateTime                            @updatedAt

  productionOrder ProductionOrder                     @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  bom             BOM?                                @relation(fields: [bomId], references: [id], onDelete: SetNull)
  lines           ProductionMaterialReservationLine[]
  materialLedgers ProductionMaterialLedger[]
  materialIssues  ProductionMaterialIssue[]

  @@index([productionOrderId])
  @@index([bomId])
  @@index([status])
  @@index([reservedAt])
}

model ProductionMaterialReservationLine {
  id              String                                  @id @default(uuid())
  reservationId   String
  inventoryItemId String
  bomItemId       String?
  warehouseId     String?
  zoneId          String?
  slotId          String?
  level           String?
  requiredQty     Float
  reservedQty     Float                                   @default(0)
  issuedQty       Float                                   @default(0)
  returnedQty     Float                                   @default(0)
  status          ProductionMaterialReservationLineStatus @default(OPEN)
  createdAt       DateTime                                @default(now())
  updatedAt       DateTime                                @updatedAt

  reservation    ProductionMaterialReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem                 @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  bomItem        BOMItem?                      @relation(fields: [bomItemId], references: [id], onDelete: SetNull)
  warehouse      MasterWarehouse?              @relation(fields: [warehouseId], references: [id])
  zone           WarehouseZone?                @relation(fields: [zoneId], references: [id])
  materialIssues ProductionMaterialIssue[]

  @@index([reservationId])
  @@index([inventoryItemId])
  @@index([bomItemId])
  @@index([warehouseId, zoneId, slotId, level])
  @@index([status])
}

model ProductionMaterialLedger {
  id                String                            @id @default(uuid())
  productionOrderId String
  reservationId     String?
  inventoryItemId   String
  warehouseId       String?
  zoneId            String?
  slotId            String?
  level             String?
  quantity          Float
  eventType         ProductionMaterialLedgerEventType
  eventDate         DateTime                          @default(now())
  remark            String?
  createdBy         String?
  createdAt         DateTime                          @default(now())

  productionOrder ProductionOrder                @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  reservation     ProductionMaterialReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem                  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  warehouse       MasterWarehouse?               @relation(fields: [warehouseId], references: [id])
  zone            WarehouseZone?                 @relation(fields: [zoneId], references: [id])

  @@index([productionOrderId])
  @@index([reservationId])
  @@index([inventoryItemId])
  @@index([eventType])
  @@index([eventDate])
  @@index([productionOrderId, eventDate(sort: Desc), id], map: "production_material_ledger_order_eventDate_id_idx")
  @@index([inventoryItemId, eventDate(sort: Desc), id], map: "production_material_ledger_item_eventDate_id_idx")
  @@index([warehouseId, zoneId, slotId, level])
}

model ProductionMaterialIssue {
  id String @id @default(uuid())

  issueNo String @unique

  productionOrderId String

  reservationId String?

  reservationLineId String?

  inventoryItemId String

  warehouseId String?

  zoneId String?

  slotId String?

  level String?

  issuedQty Float

  returnedQty Float @default(0)

  issuedBy String?

  issuedDate DateTime @default(now())

  status String @default("DRAFT")

  remarks String?

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

