/// Historical Executive Dashboard daily module snapshots.
/// TODO(raw SQL migration): convert this table to RANGE partitioning by "snapshot_date" with monthly partitions.
/// TODO(raw SQL migration): if the physical table is partitioned, PostgreSQL primary/unique constraints must include "snapshot_date".
/// TODO(raw SQL migration): add CHECK constraints for warning_count and row_count.
/// TODO(raw SQL migration): add partial indexes for stale snapshots and non-authoritative snapshots.
model DashboardSnapshot {
  id               String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshotDate     DateTime                      @map("snapshot_date") @db.Date
  module           HistoricalDashboardModule
  scopeKey         String                        @default("ALL") @map("scope_key")
  scopeType        HistoricalSnapshotScopeType   @default(GLOBAL) @map("scope_type")
  scopeId          String?                       @map("scope_id")
  granularity      HistoricalSnapshotGranularity @default(DAY)
  source           HistoricalSnapshotSource      @default(SNAPSHOT)
  authoritative    Boolean                       @default(true)
  kpis             Json                          @default("{}") @db.JsonB
  charts           Json                          @default("{}") @db.JsonB
  tables           Json                          @default("{}") @db.JsonB
  warnings         Json                          @default("[]") @db.JsonB
  metadata         Json                          @default("{}") @db.JsonB
  sourceWatermark  String?                       @map("source_watermark")
  sourceMinAt      DateTime?                     @map("source_min_at")
  sourceMaxAt      DateTime?                     @map("source_max_at")
  rowCount         Int                           @default(0) @map("row_count")
  warningCount     Int                           @default(0) @map("warning_count")
  stale            Boolean                       @default(false)
  generatedByJobId String?                       @map("generated_by_job_id") @db.Uuid
  generatedAt      DateTime                      @default(now()) @map("generated_at")
  createdAt        DateTime                      @default(now()) @map("created_at")
  updatedAt        DateTime                      @updatedAt @map("updated_at")

  generatedByJob SnapshotJob? @relation(fields: [generatedByJobId], references: [id], onDelete: SetNull)

  @@unique([module, scopeKey, snapshotDate], map: "dashboard_snapshots_module_scope_date_key")
  @@index([snapshotDate], map: "dashboard_snapshots_snapshot_date_idx")
  @@index([module, snapshotDate(sort: Desc)], map: "dashboard_snapshots_module_date_idx")
  @@index([module, scopeKey, snapshotDate(sort: Desc)], map: "dashboard_snapshots_module_scope_date_idx")
  @@index([authoritative, snapshotDate], map: "dashboard_snapshots_authoritative_date_idx")
  @@index([generatedByJobId], map: "dashboard_snapshots_generated_by_job_idx")
  @@map("dashboard_snapshots")
}

