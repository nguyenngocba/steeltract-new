NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Inject both values from the deployment secret store. Never commit real values.
DATABASE_URL=postgresql://steeltrack:replace-me@database:5432/steeltrack
JWT_SECRET=replace-with-at-least-32-random-characters

CORS_ORIGINS=https://erp.example.com
TRUST_PROXY=1
LOG_LEVEL=fatal,error,warn,log

STORAGE_ROOT=/data/steeltrack-storage
JOB_WORKER_ENABLED=true
JOB_WORKER_POLL_MS=10000
BACKGROUND_LOCK_STALE_MS=300000

USE_INVENTORY_SNAPSHOT=true
USE_PROJECT_SNAPSHOT=true
USE_PRODUCTION_SNAPSHOT=true
USE_COMPONENTS_SNAPSHOT=true
USE_QC_SNAPSHOT=true
USE_YARD_SNAPSHOT=true
USE_DISPATCH_SNAPSHOT=true
SNAPSHOT_MAX_AGE_SECONDS=900
SNAPSHOT_PARITY_CHECK=true
