STEELTRACK_BACKEND_IMAGE=registry.example.com/steeltrack/backend@sha256:<digest>
STEELTRACK_MIGRATION_IMAGE=registry.example.com/steeltrack/migration@sha256:<digest>
STEELTRACK_FRONTEND_IMAGE=registry.example.com/steeltrack/frontend@sha256:<digest>
STEELTRACK_BACKEND_ENV_FILE=/etc/steeltrack/backend.env
# Preferred production trust policy: Sigstore keyless identity issued to the
# release workflow. Replace the organization, repository and version with the
# exact release certificate identity. Do not broaden this to all workflows.
COSIGN_CERTIFICATE_IDENTITY=https://github.com/example/steeltrack/.github/workflows/production-trust.yml@refs/tags/v1.0.0
COSIGN_CERTIFICATE_OIDC_ISSUER=https://token.actions.githubusercontent.com

# Alternative for an operations-managed KMS/HSM public key. Configure either
# keyless identity/issuer above or this path, never repository-held private keys.
# COSIGN_PUBLIC_KEY_PATH=/etc/steeltrack/cosign/steeltrack.pub

STEELTRACK_SERVER_NAME=erp.example.com
STEELTRACK_HTTP_PORT=80
STEELTRACK_HTTPS_PORT=443

STEELTRACK_DATABASE_NAME=steeltrack
STEELTRACK_DATABASE_USER=steeltrack
STEELTRACK_POSTGRES_PASSWORD_FILE=/etc/steeltrack/secrets/postgres-password
STEELTRACK_TLS_CERT_FILE=/etc/steeltrack/tls/fullchain.pem
STEELTRACK_TLS_KEY_FILE=/etc/steeltrack/tls/privkey.pem
STEELTRACK_GRAFANA_PASSWORD_FILE=/etc/steeltrack/secrets/grafana-admin-password
STEELTRACK_ALERTMANAGER_CONFIG_FILE=/etc/steeltrack/alertmanager/alertmanager.yml
