{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "steeltrack-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SteelTrack AI Gateway",
      "options": {
        "baseURL": "http://193.168.113.100:8000/v1"
      },
      "models": {
        "qwen-agent": {
          "name": "Qwen Agent via Gateway"
        },
        "qwen-coder": {
          "name": "Qwen Coder via Gateway"
        }
      }
    }
  },

  "model": "steeltrack-gateway/qwen-coder",

  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "deny",
    "bash": {
      "*": "deny",
      "semble search *": "allow"
    },
    "external_directory": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "lsp": "deny"
  }
}